{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Design Visualizer",
  "version": "1.0.0",
  "identifier": "com.stephanchiorean.system-design-visualizer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "System Design Visualizer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#080a0f",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "3D system design visualizer",
    "longDescription": "Render a system design, described as JSON, as an interactive 3D scene you can play request flows through."
  }
}
